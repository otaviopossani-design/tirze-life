{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/clinica",
      "destination": "/clinica.html"
    },
    {
      "source": "/registros",
      "destination": "/registros.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
