{
  "buildCommand": "cd apps/mobile && npm install --no-audit --no-fund && npx expo export --platform web",
  "outputDirectory": "apps/mobile/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/clinica",
      "destination": "/clinica.html"
    },
    {
      "source": "/registros",
      "destination": "/registros.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
